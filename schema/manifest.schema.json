{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ngocnhanvo/source-commit-actions/schema/manifest.schema.json",
  "title": "Source Commit Request Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target_repo",
    "target_branch",
    "base_sha",
    "mode",
    "commit_message",
    "validation_preset",
    "allowed_paths"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "target_repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "target_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "mode": {
      "enum": [
        "direct_commit",
        "branch_pr"
      ]
    },
    "commit_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "validation_preset": {
      "enum": [
        "php",
        "node",
        "actions",
        "docs",
        "none"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_files": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^/].*\\.php$"
      }
    }
  }
}
